#!/bin/sh
# Baut die erzeugten Dateien vor jedem Commit neu und prueft die Kapitel.
# Der Build blockiert. Die Kapitelpruefung warnt nur.
#
# Einmalig einschalten:  git config core.hooksPath hooks
#
# Sperrklinke, optional: RATCHET=1 laesst den Commit scheitern, wenn ein Kapitel
# mehr Fehler hat als in .check-baseline geduldet. Altlast bleibt erlaubt, neue
# Verschuldung nicht.
#   dauerhaft:  git config hooks.ratchet true
#   einmalig:   RATCHET=1 git commit -m "..."
#   umgehen:    git commit --no-verify

set -e
cd "$(git rev-parse --show-toplevel)"

# python3 heisst auf manchen Systemen (u. a. Git-Bash unter Windows) nur python.
PY="$(command -v python3 || command -v python || true)"
[ -n "$PY" ] || { echo "Kein python gefunden (python3/python). Commit abgebrochen."; exit 1; }

# Nur die Projekte, an denen dieser Commit haengt. Vorher lief der Hook ueber
# alle Buecher und legte deren erzeugte Dateien mit in den Commit - ein Commit
# an Lot Fourteen hat so sechs Einfuegefassungen des zweiten Buches
# veroeffentlicht, gebaut aus unfertigen Kapiteln, die selbst nicht mitgingen.
TOUCHED="$(git diff --cached --name-only | cut -d/ -f1 | sort -u)"

for proj in */; do
  [ -f "$proj/build.py" ] || continue
  case "$TOUCHED" in
    *"${proj%/}"*) ;;
    *) continue ;;
  esac
  echo "== $proj"
  if ! "$PY" "$proj/build.py" "$proj"; then
    echo "Build fehlgeschlagen. Commit abgebrochen."
    exit 1
  fi
  if [ "${RATCHET:-$(git config --bool hooks.ratchet 2>/dev/null)}" = "1" ] \
     || [ "${RATCHET:-$(git config --bool hooks.ratchet 2>/dev/null)}" = "true" ]; then
    if ! "$PY" "$proj/check.py" --ratchet; then
      echo "Neue Stilfehler gegenueber der Basislinie. Commit abgebrochen."
      echo "Umgehen mit: git commit --no-verify"
      exit 1
    fi
  else
    "$PY" "$proj/check.py" 2>/dev/null | tail -3 || true
  fi
  # Erzeugtes einsammeln, jeden Pfad einzeln. In einem gemeinsamen Aufruf
  # laesst ein fehlender Pfad den ganzen add scheitern, und das || true
  # verschluckt es: das zweite Buch hat kein paste/, und deshalb blieben dort
  # book.md, HANDBUCH.md und MANIFEST.txt still liegen, waehrend die
  # Einfuegefassungen mitgingen. Genau die Sorte Fehler, die als Erfolg aussieht.
  for gen in book.md HANDBUCH.md MANIFEST.txt BEGEGNUNGEN.md paste; do
    [ -e "$proj$gen" ] && git add "$proj$gen" || true
  done
  git add "$proj"chapters/*.txt 2>/dev/null || true
done
